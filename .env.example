FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-this-with-a-long-random-value
# Optional. Defaults to instance/ielts_platform.sqlite3.
DATABASE_PATH=instance/ielts_platform.sqlite3
# Local AI defaults. Install Ollama and faster-whisper before using AI practice.
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
